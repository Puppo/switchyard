[
  {
    "name": "Run 1: Dispatch blue regional train, align switch to Platform A, move yellow train",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Move this train here. Dispatch the blue regional train first."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_scene",
        "arguments": {},
        "mockOutput": {
          "selectedTrainId": "yellow",
          "pinnedDestinationId": "platform-a",
          "trains": [
            {
              "id": "yellow",
              "label": "Yellow Freight Train",
              "trackId": "entry",
              "status": "idle"
            },
            {
              "id": "blue",
              "label": "Blue Regional Train",
              "trackId": "shared",
              "status": "idle"
            }
          ],
          "tracks": [
            {
              "id": "entry",
              "landmark": "Signal Box",
              "occupiedBy": "yellow",
              "connectsTo": ["shared"]
            },
            {
              "id": "shared",
              "landmark": "Main Switch",
              "canStop": false,
              "occupiedBy": "blue",
              "connectsTo": [
                "entry",
                "regional-exit",
                "platform-a",
                "platform-b"
              ]
            },
            {
              "id": "regional-exit",
              "landmark": "Regional Outbound Exit",
              "connectsTo": ["shared"]
            },
            {
              "id": "platform-a",
              "landmark": "Water Tower",
              "connectsTo": ["shared"]
            },
            {
              "id": "platform-b",
              "landmark": "Station Canopy",
              "connectsTo": ["shared"]
            }
          ],
          "switches": [
            {
              "id": "main-switch",
              "activeBranchId": "regional-exit",
              "locked": false
            }
          ],
          "closedTrackIds": []
        }
      },
      {
        "functionName": "move_train",
        "arguments": { "trainId": "blue", "destinationId": "regional-exit" },
        "mockOutput": {
          "ok": true,
          "status": "arrived",
          "trainId": "blue",
          "arrivedAtTrackId": "regional-exit"
        }
      },
      {
        "functionName": "set_switch",
        "arguments": { "switchId": "main-switch", "branchId": "platform-a" },
        "mockOutput": {
          "ok": true,
          "switchId": "main-switch",
          "activeBranchId": "platform-a"
        }
      },
      {
        "functionName": "move_train",
        "arguments": { "trainId": "yellow", "destinationId": "platform-a" },
        "mockOutput": {
          "ok": true,
          "status": "arrived",
          "trainId": "yellow",
          "arrivedAtTrackId": "platform-a"
        }
      }
    ]
  },
